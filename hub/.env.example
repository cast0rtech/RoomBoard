# Modo de autenticación con Microsoft Graph: "delegated" (mis calendarios) o "app" (buzones de sala)
AUTH_MODE=delegated

# Identificadores de la aplicación registrada en Microsoft Entra ID
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secreto de cliente (obligatorio solo si AUTH_MODE=app)
CLIENT_SECRET=

# Lista de buzones de sala separados por comas (obligatorio si AUTH_MODE=app)
ROOM_MAILBOXES=sala1@empresa.com,sala2@empresa.com

# Calendarios autorizados para sincronizar (IDs separados por comas; vacío = todos los disponibles)
SYNC_CALENDAR_IDS=

# Zona horaria IANA para las consultas a Microsoft Graph y visualización
TIMEZONE=Europe/Madrid

# Puerto local donde escucha el hub
PORT=8080

# Claves de dispositivo autorizadas (cabecera X-Device-Key), separadas por comas
DEVICE_KEYS=clave-tablet-1,clave-pc

# POLL_SECONDS se conserva como ajuste heredado; el Hub aplica 20 min en horario laboral
# y 2 h fuera de lunes a viernes, según TIMEZONE.
POLL_SECONDS=45

# Opcional: ignorar eventos de día completo en el cálculo de libre/ocupada (true/false)
IGNORE_ALL_DAY=true
